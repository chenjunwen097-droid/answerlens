# AnswerLens environment variables.
# Copy to `.env.local` for local runs, or paste the same names into your hosting
# provider (Vercel → Project → Settings → Environment Variables).
# None of these are needed to run the unit tests.

# ── DeepSeek ────────────────────────────────────────────────────────────────
# Powers the page assistant, the answer judge, and one of the two tested models.
# By default the same model is judge and tested model — a known limitation
# documented in the README.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_AGENT_MODEL=deepseek-flash
DEEPSEEK_JUDGE_MODEL=deepseek-flash
DEEPSEEK_TESTED_MODEL=deepseek-flash

# ── Zhipu GLM ───────────────────────────────────────────────────────────────
# The second tested model; also handles the vision (image) path.
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
GLM_TESTED_MODEL=glm-4.6v
GLM_VISION_MODEL=glm-4.6v

# ── Web search ──────────────────────────────────────────────────────────────
# Used by AnswerLens Copilot and for the source links attached to recommendations.
#
# Option A — hosted search API (recommended). `serper` is the provider shipped in
# api/_lib/research.js: https://serper.dev
SEARCH_PROVIDER=serper
SEARCH_API_KEY=
# SEARCH_CX=            # Google Programmable Search engine id, if your provider needs one
#
# Option B — your own SearXNG instance exposing the JSON API. Kept as a fallback:
# search engines usually captcha datacenter IPs, which is why the hosted provider
# above is the default.
# SEARXNG_BASE_URL=
# SEARCH_API_URL=
# SEARCH_API_TOKEN=
