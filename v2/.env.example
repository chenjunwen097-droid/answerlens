# Supabase (v2.0 can run without these; the report library then falls back to localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Models (server only)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# Search: DeepSeek Search/Fetch is the primary provider.
SEARCH_API_KEY=

# dsh SDK runtime (a separate long-lived Node service, not a Vercel function).
# Leave empty to use the built-in deterministic mock runtime.
AGENT_RUNTIME_URL=
AGENT_RUNTIME_TOKEN=
