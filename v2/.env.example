# Supabase (v2.0 can run without these; the report library then falls back to localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Models (server only)
# dsh SDK runtime (a separate long-lived Node service, not a Vercel function).
AGENT_RUNTIME_URL=
AGENT_RUNTIME_TOKEN=

# The frontend never calls model providers directly. Model credentials belong
# in runtime/.env, not in the Vercel project.
